rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public shop photos shown in discovery. Writes are limited to
    // authenticated clients, small images, and image content types.
    // Per-vendor path ownership enforcement moves to server-side session
    // verification (Cloud Functions) in Phase 6.
    match /vendor_images/{vendorId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
